{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/architecture.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "uv sync": "allow",
      "uv sync --locked": "allow",
      "uv run pytest*": "allow",
      "uv run python -m bench.validate*": "allow",
      "uv run python -m bench.probes validate*": "allow",
      "agents-cli lint": "allow",
      "make test": "allow",
      "make test-docker": "allow",
      "make sandbox-image": "allow",
      "make tf-fmt-check": "allow",
      "make diagrams": "allow",
      "make budget-plan*": "allow",
      "make infra-plan*": "allow",
      "make teardown-dry-run*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote -v": "allow",
      "gh repo view*": "allow",
      "gh api repos/*/forks*": "allow"
    }
  }
}
